# Database — MongoDB Atlas (or any MongoDB replica set; Prisma needs a
# replica set for transactions, and Atlas clusters are one by default, even
# on the free M0 tier).
#
# Get this from Atlas: Database > Connect > Drivers > copy the connection
# string, then fill in your database user's password and a database name.
# Keep `retryWrites=true&w=majority` — Prisma relies on write acknowledgement.
DATABASE_URL="mongodb+srv://sumonhazra9083_db_user:GSAcOvnOSkInkOLh@cluster0.f8aqxtu.mongodb.net"

# Session secret - generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# Restaurant info (used on receipts, can be edited in Owner > Settings after seeding)
RESTAURANT_NAME="Spice Route Kitchen"
RESTAURANT_TIMEZONE="Asia/Kolkata"
